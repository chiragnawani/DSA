import java.util.*;

public class Main {
    static boolean isSafe(int i, int j, int[][] board, int n){
    int col = j;
    int row = i;
    // Column Check
    while(row>0){
      row--;
      if(board[row][col]==1){
        return false;
      }
    }
    row = i;
    col = j;
    //RightDiagonalCheck
    while(row>=0 && col>=0 && col<n && row<n){
      row--;
      col++;
      if(row<0 || col==n){
        break;
      }else if(board[row][col] == 1){
        return false;
      }
    }
    //LeftDiagonalCheck
    while(row>=0 && col>=0 && col<n && row<n){
      row--;
      col--;
      if(row<0 || col<0){
        break;
      }else if(board[row][col] == 1){
        return false;
      }
    }
    return true;
  }
  static boolean checkSafe(int i, int j, int[][] board, int n){
    if(i==n){
      return true;
    }
    while(j<n){
      if(isSafe(i,j,board,n)){
        board[i][j] = 1;
        if(checkSafe(i+1,0,board,n)){
          return true
        }else{
        board[i][j] = 0;
        j++;
        }
      }else{
        j++;
      }
    }
    return false;
  };
    public static void main(String[] args) {
      int[][] board = new int[4][4];
      int j = 0, n = 4;
      for(int i = 0; i < n; i++){
        int[][] solution = checkSafe(i,j,board,n);
      }
    }
}